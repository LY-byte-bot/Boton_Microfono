<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BotonMicrofono</AssemblyName>
    <RootNamespace>BotonMicrofono</RootNamespace>
    <Version>1.6.0</Version>
    <Authors>SISTEMAS LY</Authors>
    <Company>SISTEMAS LY</Company>
    <Product>Botón Micrófono</Product>
    <Description>Control compacto para reenviar y silenciar una entrada de audio.</Description>
    <Copyright>Copyright © 2026 SISTEMAS LY. Todos los derechos reservados.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Remove="Installer\**\*.cs" />
    <EmbeddedResource Remove="Installer\**\*" />
    <None Remove="Installer\**\*" />
  </ItemGroup>
</Project>
